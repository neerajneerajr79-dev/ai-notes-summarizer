PORT=3001
CLIENT_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/mindora.sqlite
NODE_ENV=development

# Optional. Without a key, all study tools return clearly labelled demo responses.
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint, e.g. a compatible provider's /v1 URL.
OPENAI_BASE_URL=https://api.openai.com/v1
